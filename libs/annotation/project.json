{
  "name": "annotation",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/annotation/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{workspaceRoot}/dist/libs/annotation"],
      "generateExportsField": true,
      "dependsOn": ["media:build", "utilities:build"],
      "options": {
        "outDir": "../../dist/libs/annotation"
      }
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "angular",
        "postTargets": ["annotation:github"],
        "baseBranch": "main",
        "releaseAs": "patch",
        "commitMessageFormat": "build({projectName}): release version ${version}"
      }
    },
    "github": {
      "executor": "@jscutlery/semver:github",
      "options": {
        "tag": "${tag}",
        "notes": "${notes}"
      }
    },
    "npm": {
      "executor": "ngx-deploy-npm:deploy",
      "options": {
        "access": "public",
        "distFolderPath": "dist/libs/annotation"
      }
    }
  }
}
