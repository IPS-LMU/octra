{
  "name": "web-components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "octra",
  "sourceRoot": "apps/web-components/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["ngx-components:build"],
      "options": {
        "extractLicenses": true,
        "outputPath": "tmp/web-components",
        "index": "apps/web-components/src/index.html",
        "browser": "apps/web-components/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/web-components/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [],
        "styles": ["apps/web-components/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": false
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "none"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": false
          },
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "web-components:build:production"
        },
        "development": {
          "buildTarget": "web-components:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "web-components:build",
        "staticFilePath": "dist/apps/web-components/browser",
        "spa": true
      }
    },
    "version": {
      "executor": "@jscutlery/semver:version",
      "options": {
        "preset": "angular"
      }
    }
  }
}
